{
  "name": "top-view-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GPU/SQream Monitoring Dashboard — React + Apache ECharts(단일 차트 엔진), Spring REST API 직접 조회 (Prometheus 브라우저 의존성 제거)",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && npm run typecheck && npm run test:contract && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:contract": "vitest run contract.test",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.1",
    "@types/node": "^22.12.0",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.11",
    "jsdom": "24.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
